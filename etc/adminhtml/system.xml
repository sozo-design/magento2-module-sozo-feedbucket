<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="sozodesign" translate="label" sortOrder="999999" class="sozodesign-tab">
            <label>SOZO Extensions</label>
        </tab>
        <section id="sozo_feedbucket" translate="label" sortOrder="100" showInDefault="1" showInWebsite="1"
                 showInStore="1">
            <class>separator-top</class>
            <label><![CDATA[Feedbucket]]></label>
            <tab>sozodesign</tab>
            <resource>Sozo_Feedbucket::config</resource>
            <group id="hint" translate="label" type="text" sortOrder="0" showInDefault="1" showInWebsite="1"
                   showInStore="1">
                <frontend_model>Sozo\Feedbucket\Block\System\Config\Form\Fieldset\Hint</frontend_model>
            </group>
            <group id="general" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>

                <field id="enabled" type="select" translate="label" sortOrder="10" showInDefault="1" showInStore="1"
                       showInWebsite="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>

                <field id="secret" translate="label comment" type="text" sortOrder="30" showInDefault="1"
                       showInStore="1" showInWebsite="1">
                    <label>Secret</label>
                    <comment>
                        <![CDATA[The widget key from the Feedbucket install snippet (the value of <code>data-feedbucket</code>).]]>
                    </comment>
                    <depends>
                        <field id="*/*/enabled">1</field>
                    </depends>
                </field>
            </group>

            <group id="frontend" translate="label" sortOrder="12" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Frontend Configuration</label>
                <depends>
                    <field id="*/general/enabled">1</field>
                </depends>

                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInStore="1" showInWebsite="1">
                    <label>Display on Frontend?</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>

                <field id="capture_user_data" translate="label" type="select" sortOrder="11" showInDefault="1" showInStore="1" showInWebsite="1">
                    <label>Capture User Data?</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>
                        <![CDATA[
                        <p>Sends the logged-in user's name and email address to Feedbucket with their feedback, so they are named as the reporter and only see their own feedback. Set this to <strong>No</strong> to keep this information out of Feedbucket.</p>
                        ]]>
                    </comment>
                    <depends>
                        <field id="*/*/enabled">1</field>
                    </depends>
                </field>

                <field id="hide_on_checkout" translate="label comment" type="select" sortOrder="20" showInDefault="1" showInStore="1" showInWebsite="1">
                    <label>Hide on Checkout?</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>
                        <![CDATA[
                        <p>Keeps the widget off the checkout, payment review and order confirmation pages (the basket still shows it). PCI DSS 4.0 expects every script on a payment page to be listed and justified, and a screenshot could capture payment details. Only set this to <strong>No</strong> on a test site.</p>
                        ]]>
                    </comment>
                    <depends>
                        <field id="*/*/enabled">1</field>
                    </depends>
                </field>

                <field id="hide_on_account" translate="label comment" type="select" sortOrder="25" showInDefault="1" showInStore="1" showInWebsite="1">
                    <label>Hide on Account Pages?</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>
                        <![CDATA[
                        <p>Keeps the widget off My Account pages (account dashboard and details, addresses, orders, wishlist, saved cards), so a screenshot doesn't send a customer's personal data to Feedbucket. Login, registration and password reset still show it.</p>
                        ]]>
                    </comment>
                    <depends>
                        <field id="*/*/enabled">1</field>
                    </depends>
                </field>

                <field id="hidden_pages" translate="label comment" type="textarea" sortOrder="30" showInDefault="1" showInStore="1" showInWebsite="1">
                    <label>Also Hide on Pages</label>
                    <comment>
                        <![CDATA[
                        <p>Magento page names (full action names), one per line, e.g. <code>amasty_checkout_index_index</code>. End with <code>*</code> to match every page that starts with it, e.g. <code>mymodule_*</code>. Use this for third-party checkouts on their own route.</p>
                        ]]>
                    </comment>
                    <depends>
                        <field id="*/*/enabled">1</field>
                    </depends>
                </field>
            </group>

            <group id="backend" translate="label" sortOrder="16" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Backend Configuration</label>
                <comment>The admin always uses the Default Config values.</comment>
                <depends>
                    <field id="*/general/enabled">1</field>
                </depends>

                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInStore="0" showInWebsite="0">
                    <label>Display on Backend?</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>

                <field id="capture_user_data" translate="label" type="select" sortOrder="11" showInDefault="1" showInStore="0" showInWebsite="0">
                    <label>Capture User Data?</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>
                        <![CDATA[
                        <p>Sends the logged-in admin user's name and email address to Feedbucket with their feedback, so they are named as the reporter and only see their own feedback. Set this to <strong>No</strong> to keep this information out of Feedbucket.</p>
                        ]]>
                    </comment>
                    <depends>
                        <field id="*/*/enabled">1</field>
                    </depends>
                </field>

                <field id="hide_on_personal_data" translate="label comment" type="select" sortOrder="20" showInDefault="1" showInStore="0" showInWebsite="0">
                    <label>Hide on Personal Data Pages?</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>
                        <![CDATA[
                        <p>Keeps the widget off admin pages that show personal data (dashboard, customers, orders, invoices, shipments, credit memos, transactions, newsletter subscribers, customer reports, admin users), so a screenshot doesn't send it to Feedbucket.</p>
                        ]]>
                    </comment>
                    <depends>
                        <field id="*/*/enabled">1</field>
                    </depends>
                </field>

                <field id="hidden_pages" translate="label comment" type="textarea" sortOrder="30" showInDefault="1" showInStore="0" showInWebsite="0">
                    <label>Also Hide on Pages</label>
                    <comment>
                        <![CDATA[
                        <p>Admin page names (full action names), one per line, e.g. <code>review_product_edit</code>. End with <code>*</code> to match every page that starts with it, e.g. <code>mymodule_*</code>.</p>
                        ]]>
                    </comment>
                    <depends>
                        <field id="*/*/enabled">1</field>
                    </depends>
                </field>
            </group>

            <group id="ip_whitelist" translate="label" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>IP Whitelist</label>
                <depends>
                    <field id="*/general/enabled">1</field>
                </depends>

                <field id="enabled" type="select" translate="label" sortOrder="10" showInDefault="1" showInStore="1"
                       showInWebsite="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>

                <field id="add_ip" translate="label comment" type="button" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Allow output for current IP</label>
                    <frontend_model>Sozo\Feedbucket\Block\System\Config\IpButton</frontend_model>
                    <comment>Current IP will be added to whitelist</comment>
                    <depends>
                        <field id="*/*/enabled">1</field>
                    </depends>
                </field>

                <field id="whitelist" translate="label comment" type="textarea" sortOrder="30" showInDefault="1" showInStore="1" showInWebsite="1">
                    <label>IP Whitelist</label>
                    <comment><![CDATA[One entry per line: an address (IPv4 or IPv6), CIDR (<code>10.0.0.0/8</code>), address/netmask (<code>192.168.1.0/255.255.255.0</code>), wildcard (<code>192.168.*.*</code>) or range (<code>10.0.0.10-10.0.0.20</code>).]]></comment>
                    <depends>
                        <field id="*/*/enabled">1</field>
                    </depends>
                </field>
            </group>
        </section>
    </system>
</config>
