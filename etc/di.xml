  --><config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Feedbucket's own channel in the shared SOZO log (var/log/sozo/core.log), see Sozo_Core's README -->
    <virtualType name="Sozo\Feedbucket\Model\Logger" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="name" xsi:type="string">Sozo_Feedbucket</argument>
            <argument name="handlers" xsi:type="array">
                <item name="sozo" xsi:type="object">Sozo\Core\Model\Logger\VirtualDebug</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="Sozo\Feedbucket\Service\IpCheckerService">
        <arguments>
            <argument name="logger" xsi:type="object">Sozo\Feedbucket\Model\Logger</argument>
        </arguments>
    </type>
    <type name="Sozo\Feedbucket\Service\ReporterToken">
        <arguments>
            <argument name="logger" xsi:type="object">Sozo\Feedbucket\Model\Logger</argument>
        </arguments>
    </type>
</config>
